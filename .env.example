# Server
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5434
DB_USER=rtpi
DB_PASSWORD=rtpi
DB_NAME=rtpi_main
DATABASE_URL=postgresql://rtpi:rtpi@localhost:5434/rtpi_main

# Redis
REDIS_URL=redis://localhost:6381
REDIS_PASSWORD=change-this-to-a-secure-password-in-production

# Session
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Encryption
# 64-character hex key for AES-256-GCM encryption (required for Empire password storage)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Authentication
# Default Admin Account (for first-time setup)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@rtpi.local
DEFAULT_ADMIN_PASSWORD=Admin123!@
# Set to true to generate a random secure password instead of using DEFAULT_ADMIN_PASSWORD
GENERATE_ADMIN_PASSWORD=false

# Registration Settings
ALLOW_REGISTRATION=false

# Google OAuth (Production Only - uncomment and configure for production deployment)
# For local development, use username/password authentication only
# GOOGLE_CLIENT_ID=your-production-google-client-id
# GOOGLE_CLIENT_SECRET=your-production-google-client-secret
# GOOGLE_CALLBACK_URL=https://yourdomain.com/api/v1/auth/google/callback

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:5000,http://localhost:5001,localhost:5000,localhost:5001

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# AI Services (can also be configured via Settings UI at /settings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Feature Flags (v2.9.1)
# Each flag accepts: true | 1 | yes | on (anything else is false). Resolved
# server-side via shared/feature-flags.ts and exposed at GET /api/v1/settings/features.
FF_PDF_NATIVE=false           # Phase 3: app-side PDF generation
FF_VLLM_AGENT=false           # Phase 6: vLLM/Qwen-Agent inference path
FF_DOCMOST=false              # Phase 8: Docmost team-docs integration
FF_FRAMEWORK_DEPLOY=false     # Phase 9: per-framework Deploy/Teardown UI
FF_CTI_VECTOR=false           # Phase 7: CTI feeds + vector knowledge base
FF_KASM_HARDENED=false        # Phase 10: KASM socket-proxy + cert pinning
FF_DEFAULT_MCP_SERVERS=false  # v2.9.3: seed 11 default MCP servers on boot
FF_OFFSEC_MANAGED_MCP=false   # v3.0: enable POST /offsec-agents/register-mcp to
                              # register running offsec containers as managed MCP
                              # servers (docker exec -i … node /mcp/dist/index.js).
                              # Additive/opt-in — the per-call CLI bridge stays
                              # the default tool-discovery path.
FF_NEXUS_MESH=false           # v2.9.6: rust-nexus libp2p mesh transport
FF_MATRIX_A2A=false           # v2.9.6.2: MatrixA2A agent-to-agent layer
FF_GML_TELEMETRY=false        # v2.9.6.1: GML swarm-noise predictions (shadow only)
FF_A2A_CAPABILITY_GATE=false  # v2.9.6.2: enforce A2A capability matrix (post H0)
FF_TOOL_SKILL_GENERATION=false # Per-tool SKILL.md generation: on tool install/MCP
                              # start, fire a Tavily research + LLM synthesis job
                              # that writes /skills/tools/{registry}/<id>.md and
                              # injects the YAML `summary` into agent system
                              # prompts. Requires TAVILY_API_KEY and one of
                              # ANTHROPIC_API_KEY / OPENAI_API_KEY. One-shot
                              # backfill: `npm run skills:generate`.
FF_BUG_HUNTER=false           # Bug-hunter multi-agent workflow (adapted from
                              # Claude-BugHunter). When true, seeds 7 phase
                              # agents (scope/recon/hunt/chain/validate/capture/
                              # report) and mounts /api/v1/bug-hunter/* routes.
                              # Each agent uses ai.provider="auto" so Settings
                              # defaults rule (Ollama: qwen3:14b reasoning,
                              # qwen2.5-coder:14b tool-use, qwen3-embedding:4b
                              # embedding). Skill corpus lives in knowledge_base;
                              # import via `npm run bug-hunter:import-skills`.
FF_AGENT_SCOPED_ATTACK_TREE=false # Attack-tree engine convergence: when true, the
                              # "exploit" task path drives the recursive pentest via
                              # the per-agent-scoped ToolExecutionLoop — using the
                              # agent's enabledTools + systemPrompt + ## Tool Skills,
                              # with Metasploit/Empire exposed as AI-callable tools
                              # (msf_search/msf_run/empire_task) behind the approval
                              # gate. When false, the legacy Metasploit-only attack
                              # tree runs verbatim. See docs/optimization/.
FF_REQUIRE_TOOL_EVIDENCE=false # Evidence gate (stop hallucinated success): when
                              # true, a tool-execution task that produces no real
                              # evidence (exit 0 + only a banner / bare-target
                              # command / trivial output) FAILS the workflow
                              # instead of cascading fabricated context to
                              # downstream agents and the report writer. The
                              # evidence assessment (server/services/tool-evidence.ts)
                              # always runs and is logged; this flag only controls
                              # whether a zero-evidence run hard-fails. Leave false
                              # until validated, then flip to enforce.
                              # See docs/optimization/proposed-fixes/.

# UI v3.0 — design system rollout (docs/enhancements/3.0)
FF_UI_V3_TOKENS=true          # Load v3 semantic + severity color tokens and
                              # Fira font stack. Safe to leave on — purely
                              # additive (existing tokens untouched).
FF_UI_V3_GRAPHITE=false       # Switch default theme to graphite (semi-dark
                              # operator default). Off until phase 8 acceptance.
                              # Users can still pick light/dark from header.
FF_UI_V3_DENSITY_TOGGLE=true  # Comfortable/Compact/Dense toggle on operator
                              # tables (Targets, Vulnerabilities, Agents).
FF_UI_V3_LAZY_ROUTES=false    # Route-level code splitting (React.lazy) for
                              # all pages in App.tsx. Flip on once phase 6
                              # ships and bundle baseline is captured.

# KASM hardening (v2.9.1 Phase 10)
# When FF_KASM_HARDENED=true, the orchestrator's nested-container helper
# routes Docker calls through tecnativa/docker-socket-proxy with a verb
# allowlist (containers + exec + images:read + info; networks/volumes/swarm
# explicitly DENIED). Started via: docker compose --profile kasm up -d
RTPI_DOCKER_PROXY_HOST=docker-socket-proxy
RTPI_DOCKER_PROXY_PORT=2375

# KASM TLS resolution priority:
#  1) KASM_CA_PATH set         → pin to this CA (hardened, recommended)
#  2) RTPI_KASM_INSECURE_TLS=1 → fallback to rejectUnauthorized:false (dev)
#  3) neither                  → standard system trust store
KASM_CA_PATH=
RTPI_KASM_INSECURE_TLS=0

# Chromium sidecar for app-side PDF generation (v2.9.1 Phase 3, FF_PDF_NATIVE)
# Endpoint exposed by the chromedp/headless-shell container started via:
#   docker compose --profile pdf up -d
# When unset, the renderer falls back to writing HTML to disk.
CHROMIUM_WS_ENDPOINT=ws://rtpi-chromium-shell:9222

# Inference provider selection (v2.9.1 Phase 6)
# Values: auto | vllm | ollama | openai | anthropic
# `auto` walks [vllm → ollama → openai → anthropic] and uses the first that's
# configured. Per-agent overrides live in agents.inference_provider_id.
RTPI_INFERENCE_PROVIDER=auto

# ─── vLLM (alternative local inference backend — opt-in) ───────────────────
# Off by default. Started only when you bring up the vllm profile:
#   docker compose --profile vllm up -d
# Container default port maps 18000 → vLLM 8000. Uncomment both lines below
# to add vLLM to the RTPI_INFERENCE_PROVIDER auto-walk; otherwise the Ollama
# section above remains the only local inference backend.
# VLLM_BASE_URL=http://rtpi-vllm:8000
# VLLM_MODEL=Qwen/Qwen3.5-9B

# Embedding provider routing (v2.9.1 Phase 7)
# Values: auto | vllm | ollama | openai
# `auto` walks [openai → vllm → ollama] (OpenAI's text-embedding-3-small is
# 1536-dim by default, matching the schema). vLLM/Ollama require a 1536-dim
# model — e.g. `nomic-embed-text:latest` resized, or Qwen-Embedding-1.5B.
RTPI_EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small

# CTI ingestion + STIX auto-import (v2.9.1 Phase 7)
# When true, the cti-feed-ingestor cron runs every 15 min and the STIX
# import job runs ATLAS daily / ATT&CK weekly. Off by default.
RTPI_CTI_ENABLED=false

# Override the upstream STIX bundle URLs (used by /stix/atlas/refresh and
# /stix/attck/refresh). Defaults point at the official MITRE repos.
ATLAS_BUNDLE_URL=
ATTCK_BUNDLE_URL=

# Docmost team-docs integration (v2.9.1 Phase 8)
# Started via: docker compose --profile docmost up -d
# DOCMOST_BASE_URL: in-compose hostname; the published port is 13000.
# DOCMOST_API_TOKEN: created via Docmost admin UI → Settings → API tokens.
# DOCMOST_DEFAULT_WORKSPACE_ID: optional; first workspace used when unset.
DOCMOST_BASE_URL=http://rtpi-docmost:3000
DOCMOST_APP_URL=http://localhost:13000
DOCMOST_APP_SECRET=change-this-to-a-random-32-byte-secret
DOCMOST_DB_PASSWORD=docmostpassword
DOCMOST_REDIS_PASSWORD=docmostredispassword
DOCMOST_API_TOKEN=
DOCMOST_DEFAULT_WORKSPACE_ID=

# ─── Ollama (Local LLM Inference — PRIMARY backend) ────────────────────────
# Endpoint for the Ollama API. RKLLama (below) is Ollama-compatible and reuses
# the same host/port; cloud keys (OpenAI/Anthropic above) are kept only as
# fallbacks when PREFER_LOCAL_AI=true and the local host is unreachable.
OLLAMA_HOST=http://localhost:11434

# Default model used by agents/services when no model is explicitly specified.
# qwen3:14b is preferred as the default because it has stronger general
# reasoning and tool-use behavior; qwen2.5-coder:14b is selected explicitly
# for code-heavy paths (see WEB_HACKER_AI_MODEL below).
#
# Role-to-model assignments (consumed by services across the codebase):
#   General reasoning / default ............ qwen3:14b              [REQUIRED]
#   Code & tool-calling (web-hacker, agent
#     orchestration, nuclei template gen) .. qwen2.5-coder:14b      [REQUIRED]
#   Text embeddings (memory vector search,
#     mem0, RAG) ........................... nomic-embed-text       [PULL — 768-dim, ~274 MB]
#   Vision (OPTIONAL — screenshot/asset
#     triage, BBOT artefact analysis) ...... qwen2.5vl:7b           [PULL — only if vision enabled, ~6 GB]
DEFAULT_MODEL=qwen3:14b

# RKLLama / Local LLM Configuration (Orange Pi 5 Plus / RK3588 NPU)
# Only relevant when running on the Orange Pi NPU. Leave RKLLM_MODE=false on
# x86/CUDA hosts so the standard Ollama path above is used.
RKLLM_MODE=false
# Prefer local AI inference over cloud providers (Ollama/RKLLama first; cloud
# keys above are tried only on local failure).
PREFER_LOCAL_AI=false
# Default model for general tasks (must match a model available in RKLLama)
RKLLM_DEFAULT_MODEL=qwen2.5:3b
# Code analysis model
RKLLM_CODE_MODEL=qwen2.5-coder:3b
# Request timeout in ms for local inference (default: 10 min, NPU is slower than GPU)
RKLLM_TIMEOUT_MS=600000
# (OLLAMA_HOST is defined once in the Ollama section above; RKLLama reads the same var.)

# Default MCP Servers (v2.9.3 — gated by FF_DEFAULT_MCP_SERVERS)
# When the flag is true, MCPServerManager seeds 11 built-in MCP servers
# (Playwright, Chrome DevTools, fetch, filesystem, sequential-thinking,
# memory, GitHub, searchcode, claude-task-master, Tavily, arXiv) into the
# mcp_servers table on boot. Each carries a stable seed_key so future
# resync (Phase 3 POST /catalog/sync) re-inserts only missing rows.
# Sync is INSERT...ON CONFLICT DO NOTHING — never overwrites operator edits.
# Servers needing API keys stay status='stopped' until env vars are set.
# - GITHUB_PERSONAL_ACCESS_TOKEN consumed by default:github MCP server
#   (you may reuse the same PAT as GITHUB_TOKEN below or create a separate one).
# - TAVILY_API_KEY (already declared above) consumed by default:tavily MCP server.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Tool Framework
# GitHub token for accessing private repositories during auto-install
GITHUB_TOKEN=
# Path where tool registry data is stored
TOOL_REGISTRY_PATH=/opt/tools/registry
# Path where GitHub cloned tools are stored
GITHUB_CLONE_PATH=/opt/tools/github
# Default timeout for tool execution (milliseconds)
TOOL_EXECUTION_TIMEOUT=300000
# Maximum concurrent tool executions
MAX_CONCURRENT_TOOL_EXECUTIONS=5
# Enable tool auto-validation after installation
AUTO_VALIDATE_TOOLS=true

# PowerShell Empire C2
# Empire admin password (CHANGE THIS!)
EMPIRE_PASSWORD=ChangeMeNow123!
# Empire REST API URL (default: http://localhost:1337)
EMPIRE_API_URL=http://localhost:1337
# Empire SocketIO URL for real-time events (optional)
EMPIRE_SOCKETIO_URL=http://localhost:5002

# ATT&CK Workbench
# Workbench MongoDB password (CHANGE THIS!)
WORKBENCH_DB_PASSWORD=workbench123
# Workbench session secret (CHANGE THIS!)
WORKBENCH_SESSION_SECRET=change-this-workbench-secret-key
# Workbench REST API URL (default: http://localhost:3010)
WORKBENCH_API_URL=http://localhost:3010
# Workbench Frontend URL (optional - only if running workbench-ui profile)
WORKBENCH_FRONTEND_URL=http://localhost:3020

# Agent Bundle Download Tokens
# Automatically generate download tokens for new agent bundles
AGENT_TOKEN_AUTO_GENERATE=true
# Default token expiration time in hours
AGENT_TOKEN_DEFAULT_EXPIRATION_HOURS=24
# Default maximum number of downloads per token
AGENT_TOKEN_DEFAULT_MAX_DOWNLOADS=1
# Public URL for agent download links (used in token generation)
PUBLIC_URL=http://localhost:3000

# Cloudflare R2 Wordlist Storage (OffSec Agents)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=wordlist-storag

# v2.1 Autonomous Agent System
# Set to false to disable automatic agent initialization on server start
AGENT_AUTO_INITIALIZE=true
# Tool Connector Agent: polling interval in milliseconds (default: 5 minutes)
TOOL_CONNECTOR_POLL_INTERVAL=300000
# Tool Connector Agent: container name to poll for tools
TOOL_CONNECTOR_CONTAINER=rtpi-tools
# Surface Assessment Agent: maximum concurrent BBOT scans
SURFACE_ASSESSMENT_MAX_CONCURRENT=3
# Surface Assessment Agent: default BBOT preset
SURFACE_ASSESSMENT_BBOT_PRESET=kitchen-sink
# Web Hacker Agent: maximum concurrent nuclei scans
WEB_HACKER_MAX_CONCURRENT=5
# Web Hacker Agent: AI provider for template generation (anthropic or openai)
WEB_HACKER_AI_PROVIDER=anthropic
# Web Hacker Agent: AI model for template generation
WEB_HACKER_AI_MODEL=claude-sonnet-4-5
# Workflow orchestrator: default timeout per phase in milliseconds (2 hours)
WORKFLOW_DEFAULT_TIMEOUT=7200000
# Workflow retry: maximum number of retry attempts (default: 3)
WORKFLOW_RETRY_MAX_RETRIES=3
# Workflow retry: exponential backoff multiplier (default: 2)
WORKFLOW_RETRY_BACKOFF_MULTIPLIER=2
# Workflow retry: base delay between retries in milliseconds (default: 1000ms)
WORKFLOW_RETRY_BASE_DELAY_MS=1000

# Memory System (v2.3)
# Embedding provider for vector similarity search (openai, ollama, none)
MEMORY_EMBEDDING_PROVIDER=openai
# Embedding model (text-embedding-ada-002 for OpenAI, nomic-embed-text for Ollama)
MEMORY_EMBEDDING_MODEL=text-embedding-ada-002
# Embedding dimensions (1536 for ada-002, 768 for nomic-embed-text)
MEMORY_EMBEDDING_DIMENSIONS=1536
# Graph relationship features (true/false)
MEMORY_GRAPH_ENABLED=true
# Maximum graph traversal depth
MEMORY_GRAPH_MAX_DEPTH=3
# Default search result limit
MEMORY_SEARCH_DEFAULT_LIMIT=10
# Minimum similarity threshold for vector search (0.0-1.0)
MEMORY_SEARCH_MIN_SIMILARITY=0.7
# Fall back to text search when embeddings unavailable
MEMORY_SEARCH_TEXT_FALLBACK=true
# Default memory TTL in days (leave empty for permanent)
# MEMORY_DEFAULT_TTL_DAYS=
# Maximum memories per context before cleanup
MEMORY_MAX_PER_CONTEXT=1000

# ─── Production SSL / Cloudflare (Method 2 build.sh) ──────────────────────
# Required for: sudo ./build.sh --slug myorg --enable-ssl
# Domains generated: myorg.attck-node.net, myorg-reports.*, myorg-empire.*, etc.
CF_API_TOKEN=your_cloudflare_api_token_with_zone_dns_edit_permissions
CF_DOMAIN=attck-node.net
CF_ZONE_ID=your_cloudflare_zone_id_from_domain_dashboard
CF_EMAIL=your_email_for_lets_encrypt_notifications

# Cloudflare Origin CA Key (for: sudo ./build.sh --slug myorg --enable-ssl --origin-ca)
# Issues a 15-year origin certificate trusted only at the Cloudflare edge —
# Cloudflare SSL/TLS mode MUST be "Full (Strict)" for clients to see a valid
# cert chain. This is a DIFFERENT credential from CF_API_TOKEN above:
#   Cloudflare dashboard → My Profile → API Tokens → Origin CA Key → "Create Token"
# The value starts with `v1.0-...`. Leave blank to use the default Let's
# Encrypt path. Optional tuning:
#   RTPI_ORIGIN_CA_VALIDITY_DAYS  7|30|90|365|730|1095|5475 (default 5475)
#   RTPI_ORIGIN_CA_KEY_TYPE       origin-rsa|origin-ecc (default origin-rsa)
CLOUDFLARE_API_USER_SERVICE_KEY=

# ─── SysReptor ─────────────────────────────────────────────────────────────
# Profile: docker compose --profile sysreptor up -d
# UI:      http://localhost:7777
# Also edit configs/rtpi-sysreptor/app.env (SECRET_KEY, ENCRYPTION_KEYS)
SYSREPTOR_DB_PASSWORD=sysreptorpassword
SYSREPTOR_REDIS_PASSWORD=sysreptorredispassword
SYSREPTOR_URL=http://rtpi-sysreptor-app:8000
SYSREPTOR_API_TOKEN=            # Generate in SysReptor UI → User Settings → API Tokens

# ─── Portainer ─────────────────────────────────────────────────────────────
# Profile: docker compose --profile management up -d
# UI:      https://localhost:9443 (set admin password on first access)

# ─── Kasm Containerized Workspaces ─────────────────────────────────────────
# Profile: docker compose --profile kasm up -d  (includes VS Code + Kali)
# VS Code: http://localhost:6901
# Kali:    http://localhost:6902
# Usernamme: kasm_user
KASM_VNC_PASSWORD=password

# Enables KasmNginxManager — the rtpi backend writes per-workspace nginx
# configs into rtpi-kasm-proxy and reloads nginx on session lifecycle events.
# Required for Kasm workspace sessions to be reachable at their proxy URL.
KASM_PROXY_ENABLED=true

# Public HTTPS port the proxy redirects to. 8443 for dev (host port mapping),
# 443 in production behind real DNS on standard ports.
KASM_PUBLIC_HTTPS_PORT=8443

# Production TLS via Let's Encrypt (opt-in: docker compose --profile certbot)
# Set KASM_SERVER_HOSTNAME to a real domain pointed at this host. The certbot
# service issues a cert via DNS-01 (Cloudflare), copies it to kasm_nginx.crt /
# kasm_nginx.key in the kasm-certs volume, and signals rtpi-kasm-proxy to
# reload nginx. Leaving the values blank keeps the dev path on the
# self-signed cert produced by scripts/kasm/init-proxy-certs.sh.
CERTBOT_EMAIL=
CLOUDFLARE_API_TOKEN=
# Set to a real domain pointed at this host to enable certbot TLS issuance.
# Leave blank to keep the dev self-signed cert.
KASM_SERVER_HOSTNAME=

# Kasm service IDs — must be valid UUIDs; the kasmweb services crash otherwise.
# All auto-populated by scripts/bootstrap-secrets.sh.
KASM_SHARE_ID=
KASM_MANAGER_ID=
KASM_AGENT_ID=

# Kasm Postgres password (kasmapp user). Auto-populated by bootstrap-secrets.sh.
# Patched into kasm-{api,manager} api.app.config.yaml at startup.
KASM_DB_PASSWORD=
