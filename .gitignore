# Sensitive key/certificate files (defense-in-depth)
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore

# Redis
dump.rdb

# Database dumps
*.dump
# SQL dumps (but not migration files)
/*.sql
*.sql.gz
!db/migrations/*.sql
!migrations/*.sql

# Additional environment patterns
.env.production
.env.staging
.env.development
.env.test

# SysReptor secrets (use app.env.example as template)
configs/rtpi-sysreptor/app.env

# Bootstrap-generated credentials backup (lives in ~/.rtpi, defend against stray copies in repo)
.rtpi/
credentials-*.env
credentials.latest.env

# Bootstrap-rotation env backups (timestamped copies created by scripts/bootstrap-secrets.sh)
.env.old-*
.env.pre-bootstrap-*
**/*.env.old-*
**/*.env.pre-bootstrap-*

# Generic env files anywhere in the tree (keep *.example / *.sample / *.template)
**/*.env
**/*.envrc
**/secrets.env
**/*.env.private
!**/*.env.example
!**/*.env.sample
!**/*.env.template

# Claude Code local overrides (may contain auth tokens)
.claude/settings.local.json
.claude/.credentials
.claude/*.local.json
.mcp.json
.anthropic/

