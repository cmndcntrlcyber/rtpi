# Environment template for the Module 2 serving stack.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).

# ── Model source ─────────────────────────────────────────────────────────────
HF_REPO=cmndcntrlcyber/qwen14b-code-trainer-v6-gguf
GGUF_FILE=Qwen2.5-Coder-14B-Instruct-Q4_K_M.gguf
MODEL_TAG=qwen2.5-coder:14b
# HF_TOKEN=                       # only needed for private/gated repos
# EXPECTED_SHA256=                # optional integrity pin for deploy_ollama.sh

# ── Backend selection (matches RTPI's RTPI_INFERENCE_PROVIDER auto-walk) ──────
BASE_URL=http://localhost:11434/v1   # Ollama default; vLLM: http://localhost:18000/v1
MODEL=qwen2.5-coder:14b
API_KEY=ollama                       # placeholder; vLLM accepts any non-empty key
TIMEOUT_S=120

# ── Ollama tuning ────────────────────────────────────────────────────────────
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m

# ── vLLM tuning (Tier C) ─────────────────────────────────────────────────────
# VLLM_MODEL=cmndcntrlcyber/qwen14b-code-trainer-v6
# VLLM_BASE_URL=http://127.0.0.1:18000
# TP_SIZE=1
# MAX_LEN=8192

# ── Security ─────────────────────────────────────────────────────────────────
AIR_GAP_MODE=false                   # true = disable all cloud fallback
