# RTPI OffSec Agent: Web Injection Tools
# Tools for web injection testing and automation
#
# Categories: Web Injection, Automation
#
# MITRE ATT&CK Tactics: Discovery (TA0007), Reconnaissance (TA0043)

FROM rtpi/offsec-base:latest

# Set agent type for MCP server
ENV AGENT_TYPE=web-injection
ENV TOOLS_PATH=/opt/tools

# Switch to root for package installation
USER root

# Install dependencies. apt retry/timeout config inherited from offsec-base.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    for i in 1 2 3; do \
      apt-get update && break || { echo "apt-get update failed (attempt $i)"; sleep $((i*5)); }; \
    done; \
    apt-get install -y --no-install-recommends \
      curl wget \
      git

# Create directories
RUN mkdir -p /opt/tools/bin

# =============================================================================
# TOOL: catch (cmndcntrlcyber/catch)
# Language: Node.js  (the repo is "universal-web-security-framework"; `node server.js`.
#   Its Rust component lives in the `tauri-executor` submodule — a Tauri GUI app, not a
#   headless CLI — so there is no `catch` binary to compile. We provision the Node app
#   and expose a `catch` launcher on PATH.)
# Description: For automating the boring stuff
# =============================================================================

USER rtpi-agent

# Clone (recursing the tauri-executor submodule) and install Node dependencies. These
# MUST succeed or the image build aborts — previously the build assumed a Rust `cargo`
# project and silently shipped without any `catch`, so the tool was absent everywhere.
RUN cd /opt/tools && \
    git clone --depth 1 --recurse-submodules https://github.com/cmndcntrlcyber/catch.git && \
    cd catch && \
    npm install --omit=dev

# Switch to root to install the launcher
USER root

# `catch` launcher on PATH. `--help`/`-h`/no-arg print a one-line summary and exit 0 so
# the tool-connector discovery (`which catch && catch --help`) registers it cleanly and
# never accidentally starts the server; any other args exec the Node app.
RUN printf '%s\n' \
      '#!/bin/sh' \
      '# catch - universal-web-security-framework (Node.js) launcher' \
      'case "$1" in' \
      '  -h|--help|"")' \
      '    echo "catch - universal-web-security-framework (Node.js). Usage: catch start [args] | catch --help"' \
      '    echo "Runs: node /opt/tools/catch/server.js"' \
      '    exit 0 ;;' \
      'esac' \
      'exec node /opt/tools/catch/server.js "$@"' \
      > /opt/tools/bin/catch && \
    chmod +x /opt/tools/bin/catch

# Create TOOL_INFO.txt
RUN echo "catch - For automating the boring stuff" > /opt/tools/catch/TOOL_INFO.txt && \
    echo "Repository: https://github.com/cmndcntrlcyber/catch" >> /opt/tools/catch/TOOL_INFO.txt && \
    echo "Language: Node.js (universal-web-security-framework)" >> /opt/tools/catch/TOOL_INFO.txt

# =============================================================================
# CLEANUP AND PERMISSIONS
# =============================================================================

ENV PATH="/opt/tools/bin:${PATH}"

# Set ownership
RUN chown -R rtpi-agent:rtpi-agent /opt/tools

# Switch to non-root user
USER rtpi-agent
WORKDIR /home/rtpi-agent

# Build MCP server
WORKDIR /mcp
RUN npm run build

# Expose MCP port
EXPOSE 9000

# Health check
HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD pgrep -f "node.*mcp" || exit 1

# Start MCP server
ENTRYPOINT ["/usr/local/bin/mcp-entrypoint.sh"]