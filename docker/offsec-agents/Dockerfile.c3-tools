# RTPI OffSec Agent: C3 (Custom Command and Control)
# Windows-focused C2 framework for covert operations
#
# Categories: C2 Frameworks, Covert Channels, Post-Exploitation
# Primary Focus: C3 relay network and covert channel management
# Source: https://github.com/ReversecLabs/C3
#
# MITRE ATT&CK Tactics: Command and Control (TA0011), Defense Evasion (TA0005)

FROM rtpi/offsec-base:latest

# Set agent type for MCP server
ENV AGENT_TYPE=c3-c2
ENV TOOLS_PATH=/opt/tools
ENV C3_HOME=/opt/c3

# Switch to root for package installation
USER root

# Install C3 dependencies. apt retry/timeout config inherited from offsec-base.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    for i in 1 2 3; do \
      apt-get update && break || { echo "apt-get update failed (attempt $i)"; sleep $((i*5)); }; \
    done; \
    apt-get install -y --no-install-recommends \
      build-essential cmake \
      mingw-w64 \
      nmap netcat-openbsd socat \
      openssl libssl-dev \
      python3-dev python3-pip \
      unzip jq git

# Install .NET SDK 8.0 (C3 gateway uses .NET). Retry the third-party-repo
# update separately so a Microsoft mirror blip doesn't kill the whole layer.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    for i in 1 2 3; do \
      apt-get update && break || { echo "apt-get update failed (attempt $i)"; sleep $((i*5)); }; \
    done; \
    apt-get install -y --no-install-recommends wget; \
    . /etc/os-release; \
    wget -q "https://packages.microsoft.com/config/ubuntu/${VERSION_ID}/packages-microsoft-prod.deb" 2>/dev/null || true; \
    dpkg -i packages-microsoft-prod.deb 2>/dev/null || true; \
    rm -f packages-microsoft-prod.deb; \
    for i in 1 2 3; do \
      apt-get update && break || { echo "apt-get update (microsoft repo) failed (attempt $i)"; sleep $((i*5)); }; \
    done; \
    apt-get install -y --no-install-recommends dotnet-sdk-8.0 || echo "dotnet-sdk-8.0 not available for this architecture"

# Clone and build C3
RUN mkdir -p ${C3_HOME} && \
    git clone --depth 1 https://github.com/ReversecLabs/C3.git ${C3_HOME}/src || \
    echo "C3 clone deferred to activation"

# Install Python dependencies for C3 management
RUN pip3 install --no-cache-dir \
    requests \
    websockets \
    pycryptodome \
    2>/dev/null || true

# Create activation directory
RUN mkdir -p /opt/c2-setup

# Copy dormant entrypoint
COPY c3-entrypoint.sh /opt/c3-entrypoint.sh
RUN chmod +x /opt/c3-entrypoint.sh

# C3 Gateway web UI port + MCP server
EXPOSE 52935 9000

# Switch back to agent user
USER rtpi-agent
WORKDIR /home/rtpi-agent

ENTRYPOINT ["/opt/c3-entrypoint.sh"]
