# /etc/default/rtpi-startup — environment overrides for rtpi-startup.service.
#
# All variables have sensible defaults in scripts/rtpi-startup.sh; only
# uncomment what you need to change.

# App mode: "native" runs the Node server directly, "docker" uses the
# containerized app from docker-compose.prod.yml.
# RTPI_APP_MODE=native

# Docker Compose project name (must match the label on your containers).
# RTPI_COMPOSE_PROJECT=rtpi

# Port the RTPI API listens on (used for readiness probing).
# PORT=3000

# Path to the readiness file written by the server after boot.
# RTPI_READY_FILE=/tmp/rtpi-ready

# Uncomment to skip optional profiles (kasm, offsec-agents, vpn, etc.)
# and only start core infra + app + API-dependent services.
# Set any value to "true" in .env to have the startup script bring up
# the corresponding profile automatically.
# KASM_ENABLED=false
# OFFSEC_ENABLED=false
# VPN_ENABLED=false
