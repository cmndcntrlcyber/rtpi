# /etc/default/rtpi-watcher — production overrides for rtpi-watcher.service.
#
# All variables are optional; the script ships sensible defaults. Set any of
# these to override. After editing, run:
#   sudo systemctl restart rtpi-watcher.service

# Poll interval in seconds.
RTPI_WATCHER_INTERVAL=60

# Health endpoint to probe. If empty, API checks are skipped entirely.
RTPI_WATCHER_API_HEALTH_URL=http://localhost:3000/api/v1/health
RTPI_WATCHER_API_TIMEOUT=10

# Container that hosts the API. If the /health probe fails, the watcher
# will `docker restart` this container. Set empty to disable.
# Use this only if the API runs inside docker. If the API runs on the host
# under its own systemd unit, leave empty and add a separate ExecStartPost=
# hook that restarts that unit instead — see docs/operations/rtpi-watcher.md.
#RTPI_WATCHER_API_CONTAINER=rtpi-app

# Docker compose project label that the watcher should sweep. Match this to
# `docker compose -p <name>`. Defaults to "rtpi".
RTPI_WATCHER_PROJECT=rtpi

# Comma-separated container names to skip even if they look unhealthy.
# Useful for one-shot init containers that exit 0 but show up as "exited",
# or for kasm-* services with cosmetic-only healthcheck flakes.
#RTPI_WATCHER_IGNORE=rtpi-kasm-db-init,rtpi-kasm-proxy-init

# Per-target rate limit. After N restarts of the same container inside the
# window, quarantine that container until the window slides off. Prevents
# the watcher from amplifying a real bug into a restart storm.
RTPI_WATCHER_MAX_RESTARTS=3
RTPI_WATCHER_WINDOW=600

# Minimum seconds between any two heal actions (across all targets).
RTPI_WATCHER_COOLDOWN=15

# Postgres probe — uses `docker exec <container> pg_isready -U $USER -d $DB`.
RTPI_WATCHER_PG_CONTAINER=rtpi-postgres
RTPI_WATCHER_PG_USER=rtpi
RTPI_WATCHER_PG_DB=rtpi_main

# 1 = log what would happen but don't run docker restart. Useful for the
# first hour after install.
RTPI_WATCHER_DRY_RUN=0

# 1 = print extra debug lines (every tick, every state inspection).
RTPI_WATCHER_DEBUG=0
