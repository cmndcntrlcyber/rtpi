# /etc/default/rtpi — environment overrides for rtpi.service.
#
# Values here supplement the project .env file. Use this for systemd-specific
# overrides; most config belongs in .env itself.

# Docker Compose project name.
# RTPI_COMPOSE_PROJECT=rtpi

# Uncomment to enable specific profiles. Each profile starts its group of
# Docker containers. Comment out or set to "false" to skip.
# KASM_ENABLED=true
# OFFSEC_ENABLED=true
# SYSREPTOR_ENABLED=true
# DOCMOST_ENABLED=true
# VPN_ENABLED=true
# MEM0_ENABLED=true
# PDF_ENABLED=true
# PORTAINER_ENABLED=true
# OLLAMA_ENABLED=true
# VLLM_ENABLED=true
